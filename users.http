### ========================================
### API USERS - SISTEMA DE CREDENCIALES
### ========================================

@baseUrl = http://localhost:4000/api/v1
@authToken = {{login.response.body.token}}

### ========================================
### 1. AUTENTICACIÓN
### ========================================

### Registrar un nuevo usuario
# @name register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Admin User",
  "username": "admin12",
  "email": "admin12@example.com",
  "password": "123456",
  "roles": ["admin"]
}

### Iniciar sesión
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin12@example.com",
  "password": "123456"
}

### ========================================
### 2. ROLES
### ========================================

### Obtener todos los roles
GET {{baseUrl}}/roles
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjY4NTliNGNjNTc3Zjc1OWExN2VhMjQ1ZiIsImlhdCI6MTc1MDczMTY5NSwiZXhwIjoxNzUzMzIzNjk1fQ.oZq0LJ3Y9S0v0-pT5nxSxvH9UsF5qBtXSCuPBskvgHw

### Obtener un rol por ID
GET {{baseUrl}}/roles/68549b16a83fe67b37237368
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjY4NTliNGNjNTc3Zjc1OWExN2VhMjQ1ZiIsImlhdCI6MTc1MDcxNjI2MCwiZXhwIjoxNzUzMzA4MjYwfQ.E7jIY89OhxiI5FIQ6oZapq2IlDwbYn-kkUfJjFN27Fg

### Crear un nuevo rol
POST {{baseUrl}}/roles
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjY4NTliNGNjNTc3Zjc1OWExN2VhMjQ1ZiIsImlhdCI6MTc1MDcxNjI2MCwiZXhwIjoxNzUzMzA4MjYwfQ.E7jIY89OhxiI5FIQ6oZapq2IlDwbYn-kkUfJjFN27Fg
Content-Type: application/json

{
  "name": "funcionario",
  "description": "Rol para funcionarios del sistema",
  "permissions": ["credentials_read", "credentials_create"]
}

### Actualizar un rol
PUT {{baseUrl}}/roles/6859b52a577f759a17ea246e
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjY4NTliNGNjNTc3Zjc1OWExN2VhMjQ1ZiIsImlhdCI6MTc1MDcxNjI2MCwiZXhwIjoxNzUzMzA4MjYwfQ.E7jIY89OhxiI5FIQ6oZapq2IlDwbYn-kkUfJjFN27Fg
Content-Type: application/json

{
  "name": "funcionario_actualizado",
  "description": "Rol actualizado para funcionarios",
  "permissions": ["credentials_read", "credentials_create", "credentials_update"]
}

### Eliminar un rol
DELETE {{baseUrl}}/roles/6859b52a577f759a17ea246e
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZCI6IjY4NTliNGNjNTc3Zjc1OWExN2VhMjQ1ZiIsImlhdCI6MTc1MDcxNjI2MCwiZXhwIjoxNzUzMzA4MjYwfQ.E7jIY89OhxiI5FIQ6oZapq2IlDwbYn-kkUfJjFN27Fg

